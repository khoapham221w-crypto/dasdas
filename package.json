{
  "name": "thanh-nu-api",
  "version": "0.5.9",
  "description": "Code By Thánh Nữ v0.5.9 - OCR/batch race guards, robust capture bounds, stable manual verification UI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "sharp": "0.33.5",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "local.thanhnu.api",
    "productName": "Code By Thánh Nữ",
    "files": [
      "main.js",
      "preload.js",
      "renderer.html",
      "renderer.js",
      "style.css",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "artifactName": "CodeByThanhNu-${version}-portable.exe"
  }
}